[Unit]
Description=EventLens 24x5 EUR/USD Macro Event Shadow Runtime (cTrader Open API Demo)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=eventlens
Group=eventlens
WorkingDirectory=/opt/eventlens
EnvironmentFile=/etc/eventlens/eventlens.env

# Shadow accounting only. Demo broker order mirroring is blocked pending
# position-aware closes, confirmed fills, and durable reconciliation acceptance.
ExecStart=/opt/eventlens/.venv/bin/eventlens-shadow start \
    --continuous \
    --shadow-db /var/lib/eventlens/data/shadow-ledger.sqlite \
    --memory-db /var/lib/eventlens/data/shadow-memory.sqlite \
    --observer-db /var/lib/eventlens/data/observer.sqlite \
    --quotes-db /var/lib/eventlens/data/live-quotes.sqlite \
    --poll-news \
    --news-source tier1_english \
    --supplement-calendar-actuals \
    --call-model \
    --ctrader-openapi \
    --ctrader-sample-interval-ms 200 \
    --enable-stateful-reviews \
    --review-breakout-pips 12 \
    --periodic-review-seconds 1800 \
    --max-total-review-calls 500 \
    --max-daily-llm-calls 80 \
    --close-on-stop \
    --exit-drain-timeout 60

# Graceful drain on systemctl stop / restart: ShadowRunner traps SIGTERM,
# attempts Shadow exits with valid quotes or records a handoff when quotes are unavailable.
# This does not close any broker positions.
KillSignal=SIGTERM
TimeoutStopSec=90
Restart=always
RestartSec=10

# Systemd sandboxing & privilege hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/eventlens

[Install]
WantedBy=multi-user.target
