# EventLens 24x5 Cloud Runtime Environment (Ubuntu 24.04 LTS / systemd)
# Copy to /etc/eventlens/eventlens.env and restrict permissions:
#   sudo chown eventlens:eventlens /etc/eventlens/eventlens.env
#   sudo chmod 600 /etc/eventlens/eventlens.env
# NEVER commit real credentials to Git or paste them into chat logs.

# 1. DeepSeek API Key (used by SinglePassTradingAgent; capped by --max-daily-llm-calls)
DEEPSEEK_API_KEY=replace_with_deepseek_api_key

# ==============================================================================
# 2A. Primary Cloud Mode: Headless Docker cTrader CLI (`eventlens-ctrader-cli` + `eventlens-shadow-cli`)
# ==============================================================================
# Builds `EventLensCliBridge.algo` (`TargetFramework=net6.0`, required by `cTrader.Automate 1.0.21` packager)
# via `mcr.microsoft.com/dotnet/sdk:8.0` and runs it inside Spotware's official console image
# (`ghcr.io/spotware/ctrader-console:latest` on linux/amd64; upstream `Config.User` is empty so the container
# runs as root by default — non-root real-account execution is not verified).
# Store your single-line cTID password separately in /etc/eventlens/ctrader-cli.pwd (root:root, chmod 0600, no ACLs).
CTRADER_CTID=replace_with_ctid_email_or_username

# Positive 64-bit integer Demo trading account number shown inside cTrader (e.g., Pepperstone Demo Razor).
# Enforced by both EventLensCliBridge.cs (`string` parsed via strict `long.TryParse`) and Python CTraderCliDemoBrokerAdapter:
# refuses startup/new risk if Account.IsLive == true, Account.Number != ExpectedDemoAccountNumber,
# or Account.Asset.Name != ExpectedAccountCurrency.
CTRADER_DEMO_ACCOUNT_NUMBER=replace_with_demo_account_login_number
CTRADER_EXPECTED_ACCOUNT_CURRENCY=USD

# Keep false for read-only 24x5 quote bridge + local Shadow ledger.
# Set to true ONLY when running the supervised Cloud Demo order lifecycle acceptance runbook:
#   1. Verify read-only preflight: `eventlens-shadow demo-reconcile`
#   2. Run bounded model-free smoke test: `eventlens-shadow demo-smoke --confirm-demo-execution`
#   3. If an ambiguous crash ever sets `manual_unlock_required`, inspect the Demo account and run
#      `eventlens-shadow demo-unlock --note "<verified state>"` before new risk can resume.
CTRADER_ALLOW_DEMO_ORDERS=false

# Optional extra CLI flags appended to eventlens-shadow-cli.service.
# Leave empty for Shadow-only operation. For opt-in Cloud Demo order submission:
#   EXTRA_SHADOW_ARGS="--ctrader-cli-demo-orders --confirm-demo-execution"
EXTRA_SHADOW_ARGS=

# ==============================================================================
# 2B. Alternative Quote-Only Mode: Spotware cTrader Open API (`eventlens-shadow`)
# ==============================================================================
# Spotware cTrader Open API Credentials (from https://openapi.ctrader.com/apps)
CTRADER_CLIENT_ID=replace_with_ctrader_client_id
CTRADER_CLIENT_SECRET=replace_with_ctrader_client_secret

# Initial OAuth2 tokens generated once via Spotware Playground ("Get Token").
# On an expired-token authentication failure, EventLens attempts token refresh and persists tokens
# with 0600 permissions to CTRADER_TOKEN_FILE below.
CTRADER_ACCESS_TOKEN=replace_with_initial_access_token
CTRADER_REFRESH_TOKEN=replace_with_initial_refresh_token
CTRADER_TOKEN_FILE=/var/lib/eventlens/ctrader_tokens.json

# Demo-Only Endpoint & Verified Pepperstone Demo Account Lock
# Hard safety lock: CTraderOpenApiConfig rejects any "live" hostname, and
# CTraderOpenApiClient verifies isLive == False via ProtoOAGetAccountListByAccessTokenReq (2149)
# BEFORE sending ProtoOAAccountAuthReq (2102).
CTRADER_HOST=demo.ctraderapi.com
CTRADER_PORT=5036

# Set your own ctidTraderAccountId (not the login number shown in the trading app).
# The client verifies isLive=false before authenticating this account.
CTRADER_ACCOUNT_ID=replace_with_demo_ctid_trader_account_id
